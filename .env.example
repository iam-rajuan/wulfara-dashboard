# Dashboard Environment Variables

# The base URL of the Backend API (e.g., https://api.yourdomain.com/api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# The base URL of the Backend Socket.io Server (e.g., https://api.yourdomain.com)
VITE_SOCKET_URL=http://localhost:5000

# The base URL of the Frontend Application (e.g., https://www.yourdomain.com)
VITE_FRONTEND_URL=http://localhost:3000
